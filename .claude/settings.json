{
  "permissions": {
    "allow": [
      "Bash(bash scripts/session-inject.sh)",
      "Bash(bash scripts/session-inject.sh *)",
      "Bash(python3 scripts/memory-flush.py)",
      "Bash(python3 scripts/activity-log.py)",
      "Bash(python3 scripts/loop-detector.py)",
      "Bash(python3 scripts/guard-dangerous.py)",
      "Bash(bash scripts/dream-hook.sh)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/session-inject.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/loop-detector.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/guard-dangerous.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/activity-log.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/dream-hook.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/memory-flush.py"
          }
        ]
      }
    ]
  }
}
